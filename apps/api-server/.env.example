# Server Config
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# PostgreSQL Database Config
# Local config (optional if using DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password
DB_DATABASE=wearsy_db

# Supabase / Remote PostgreSQL Config
# Lấy từ Supabase Dashboard -> Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DB_SSL=true
DB_SYNCHRONIZE=false

# JWT Security
JWT_SECRET=wearsy_super_secret_jwt_key_2026
JWT_EXPIRATION_TIME=86400s

# AI Service Engine Integration
AI_ENGINE_URL=https://api.openai.com/v1
AI_ENGINE_API_KEY=your_ai_service_api_key

# SMTP Mailer Config (Brevo / Nodemailer)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_smtp_login@smtp-brevo.com
MAIL_PASS=your_smtp_key
MAIL_FROM="WEARSY Support <vo.thedan@outlook.com>"

